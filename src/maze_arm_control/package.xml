<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>maze_arm_control</name>
  <version>0.1.0</version>
  <description>Remote-pivot board tilt control (A1, #14): /board/tilt_cmd to UR7e joint velocities, /board/tilt_state from FK.</description>
  <maintainer email="leotcchen@berkeley.edu">Leo Chen</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>eigen3_cmake_module</buildtool_depend>

  <build_depend>eigen</build_depend>
  <build_export_depend>eigen</build_export_depend>

  <depend>rclcpp</depend>
  <depend>maze_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>controller_manager_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>yaml_cpp_vendor</test_depend>
  <test_depend>maze_sim_bringup</test_depend>
  <test_depend>maze_sim_description</test_depend>
  <test_depend>maze_control</test_depend>
  <test_depend>maze_arm</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
